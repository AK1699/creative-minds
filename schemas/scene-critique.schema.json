{
  "$id": "scene-critique.schema.json",
  "title": "Scene critique (Scene + Continuity Quality Gates)",
  "description": "reports/scene-critique.json — per-scene verdicts. verdict=fail triggers regeneration of ONLY the failed scenes.",
  "type": "object",
  "required": ["verdict", "scene_count_expected", "scene_count_actual", "scenes"],
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "fail"] },
    "scene_count_expected": { "type": "integer", "minimum": 1 },
    "scene_count_actual": { "type": "integer", "minimum": 0 },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_number", "verdict", "issues", "required_changes"],
        "properties": {
          "scene_number": { "type": "integer", "minimum": 1 },
          "verdict": { "type": "string", "enum": ["pass", "fail"] },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["gate", "severity", "note"],
              "properties": {
                "gate": { "type": "string", "enum": ["scene", "continuity", "caption"] },
                "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
                "note": { "type": "string" }
              }
            }
          },
          "required_changes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "global_issues": { "type": "array", "items": { "type": "string" }, "description": "Sequence-level problems: caption voice drift, pacing, missing count" }
  }
}
