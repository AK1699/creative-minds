{
  "$id": "selected-concept.schema.json",
  "title": "Concept evaluation and selection",
  "description": "story/selected-concept.json — scored evaluation of every concept and the winning choice.",
  "type": "object",
  "required": ["selected_id", "evaluation", "rationale"],
  "properties": {
    "selected_id": { "type": "string" },
    "rationale": { "type": "string" },
    "evaluation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scores", "total"],
        "properties": {
          "id": { "type": "string" },
          "scores": {
            "type": "object",
            "required": ["originality", "emotional_authenticity", "visual_potential", "audience_fit"],
            "properties": {
              "originality": { "type": "integer", "minimum": 1, "maximum": 5 },
              "emotional_authenticity": { "type": "integer", "minimum": 1, "maximum": 5 },
              "visual_potential": { "type": "integer", "minimum": 1, "maximum": 5 },
              "audience_fit": { "type": "integer", "minimum": 1, "maximum": 5 }
            }
          },
          "total": { "type": "integer" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
